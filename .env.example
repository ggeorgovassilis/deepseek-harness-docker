# Exact official @deepseek-ai/dsh version packaged by the image.
DSH_VERSION=0.2.1-rc.2

# Immutable container revision. This is separate from the packaged DSH version.
DSH_IMAGE_VERSION=0.2.1-rc.2-r1
# Optional privacy-focused browser variant:
# DSH_IMAGE_VERSION=0.2.1-rc.2-r1-ungoogled.1
# Optional bubblewrap fallback for Docker hosts without Landlock; use together
# with compose.bwrap.yaml, not as a standalone image selection:
# BWRAP_IMAGE_VERSION=0.2.1-rc.2-r1-bwrap.1

# Published registry repository. Use ghcr.io/runzhliu/deepseek-harness for GHCR.
DSH_IMAGE_REPOSITORY=docker.io/runzhliu/deepseek-harness

# Official Node image used by both the default and optional-market builders.
# Trixie provides glibc 2.41; the non-slim variant includes common build tools.
NODE_IMAGE=docker.io/library/node:24-trixie

# Package manager bundled for runtime plugin operations.
PNPM_VERSION=11.19.0

# Host loopback port. Do not change the bind address in compose.yaml.
DSH_PORT=3080

# Extra authority the loopback Web UI accepts in its Host header. Set this to
# a hostname alias you browse the UI with (e.g. control.dsh in /etc/hosts).
# DSH_WEB_TRUSTED_HOST=control.dsh

# Host loopback port for the interactive noVNC desktop.
DSH_DESKTOP_PORT=6080

# Attach official Playwright MCP Browser Use to the visible Chromium. Set to 0
# before startup only when selecting another official Browser Use provider.
DSH_BROWSER_USE_ENABLED=1

# Only needed when the container has multiple candidate network interfaces.
# Select the one reached by Docker port publication or the intended Service.
# DSH_WEB_RELAY_INTERFACE=eth0

# Absolute or relative host path exposed to the Agent as /workspace. Leave the
# default named volume in place until you intentionally select a host project.
DSH_WORKSPACE=dsh-workspace

# Optional: expose a host directory to DSH at the SAME absolute path inside the
# container. The Jabofish VS Code extension sends host filesystem paths to DSH,
# so this bind mount makes those paths resolve identically in the container.
# Set it to the directory that holds your VS Code projects, e.g.:
# DSH_HOST_PATH=/home/YOUR_USER/workspace

# DeepSeek API key, passed straight into the container as the host credential
# referenced by the DeepSeek provider (apiKeyEnv: DEEPSEEK_API_KEY). Prefer a
# Secret or the Web UI settings over committing a real key here.
DEEPSEEK_API_KEY=

# GitHub PAT for in-container git/gh. Set both to the same value. At container
# start the token is persisted to gh's config file ($GH_CONFIG_DIR, in the
# dsh-home volume) because DSH scrubs *TOKEN* env vars from the agent's shell;
# git and gh then authenticate from that file. A classic PAT with `repo` scope
# is sufficient (read:org is not required). Leave empty to skip git/gh setup.
GH_TOKEN=
GITHUB_TOKEN=
